# Private Supabase Edge Function secrets (predict). Never ship these in Expo.
MODEL_PROVIDER=hosted
HOSTED_MODEL_DISCLOSURE=cloudflare-deepinfra-v1
# Dedicated Workers Free account only. Never upgrade or enable billable overage.
CLOUDFLARE_WORKERS_PLAN=free
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
DEEPINFRA_API_KEY=
# Each flag approves its pinned provider/model after its OWN semantic/safety review.
CLOUDFLARE_QUALITY_APPROVED=false
DEEPINFRA_QUALITY_APPROVED=false
APP_ORIGIN=
WEB_READING_SALT=
WEB_READING_DAILY_CAP=500
SCHEDULER_SECRET=
APNS_KEY_ID=
APNS_TEAM_ID=
# Complete PKCS8 PEM, kept server-only.
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.janustsen.crystalball
APNS_ENVIRONMENT=production
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY=
APPLE_CLIENT_ID=com.janustsen.crystalball
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
