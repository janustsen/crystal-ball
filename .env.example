# Public app configuration. Use this task's local Supabase keys only.
# Engine selection and local browser/native overrides: SETUP.md#local-development.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Purchase modes and release-build safeguards: docs/launch/billing.md#how-it-works.
EXPO_PUBLIC_REVENUECAT_MODE=mock
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# Server-only; never EXPO_PUBLIC.
OLLAMA_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
MODEL_PROVIDER=ollama
HOSTED_MODEL_URL=
HOSTED_MODEL_NAME=
HOSTED_MODEL_KEY=
APP_ORIGIN=http://localhost:8087
# Social moderation service only; never use EXPO_PUBLIC for the service-role key.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=
# Local-only mock purchases through the real ledger. Hosted URLs reject this mode.
SOCIAL_MOCK_ENTITLEMENTS=false
# Server-only billing: RevenueCat v1 secret key for reconciliation, and the webhook Authorization value.
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
# Enable only after Apple/Supabase linking is configured; preserves anonymous UID.
EXPO_PUBLIC_APPLE_LINK_ENABLED=false
# Local disclosure stays blank. Public provider-chain templates: supabase/hosted.env.example and docs/launch/hosted-app.env.example.
# Public consent configuration: follow docs/launch/hosted-model.md#deployment-handoff-and-exact-secrets.
HOSTED_MODEL_DISCLOSURE=
EXPO_PUBLIC_AI_PROVIDER_NAME=
# Local Node testing only: MODEL_PROVIDER=codex uses the existing Codex login.
# Never configure this provider on a deployed server. No API key is needed.
CODEX_MODEL=gpt-6-luna

# Released app store / install landing URL for browser sealed-card visitors.
# EXPO_PUBLIC_INSTALL_URL=https://your-published-install-page.example
# Native push credentials and scheduler settings: docs/launch/infrastructure.md.

# Shared-link and export origin: see SETUP.md#social-v2-delivery.
# EXPO_PUBLIC_WEB_ORIGIN=https://your-crystal-ball-web.example

# Streamed room loop base (flights are bundled); packaging, fallback and local/hosted setup: SETUP.md#room-renders.
# EXPO_PUBLIC_ROOM_ASSET_BASE=/room

# Server-only web-reading limits: see SETUP.md#social-v2-delivery.
# WEB_READING_DAILY_CAP=500
# WEB_READING_SALT=
