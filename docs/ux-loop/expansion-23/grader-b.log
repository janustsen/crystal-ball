const task=()=>'<section class="task"><h2>Did it happen?</h2><p class="small">Save how this forecast turned out.</p>'+['Yes','Not quite','Not yet'].map(x=>'<button class="outcome" aria-label="'+x+'" aria-pressed="false">'+x+'</button>').join('')+'</section>';
const forecast=()=>qualification+'<h1>'+headline+'</h1><p class="small">Check back · Apr 2, 2027</p>';
const links='<button class="quiet" data-study="Evidence">Why this forecast ›</button><button class="quiet" data-study="Share">Share this glimpse ↗</button>';
const categories=['Why this forecast','Your answers','Assumptions','Current sources'];
const categoryList=()=>'<div class="sections">'+categories.map(x=>'<button data-category="'+x+'"><span>'+x+'</span><span aria-hidden="true" class="gold">›</span></button>').join('')+'</div>';
function render(){let html=header;
if(screen==='compose'){
 if(variant==='a')html+='<div class="context-line"><span class="small">About myself</span><button data-study="Person editor" class="gold">Change</button></div>'+field()+submit+'<p class="small">A glimpse, not a promise.</p>';
 if(variant==='b')html+='<h1 class="editor-title">Ask the Ball</h1><div class="writing">'+field()+'<button data-study="Person editor" class="gold">About myself · Change</button></div><div class="dock">'+submit+'</div>';
 if(variant==='c')html+=editing?'<h1 class="editor-title">Edit your question</h1>'+field()+'<button id="save" class="primary">Save question</button><button id="cancel" class="quiet">Cancel changes</button>':'<p class="small">About myself</p><h1>'+draft+'</h1><button id="edit" class="top-action">Edit question ↗</button>'+submit;
}
if(screen==='forecast'){
 if(variant==='a')html+='<p class="small">Check-in</p><p class="compact-title">'+headline+'</p>'+qualification+task()+links;
 if(variant==='b')html+='<div class="tabs"><button id="forecast-tab" aria-pressed="'+(tab==='forecast')+'">Forecast</button><button id="check-tab" aria-pressed="'+(tab==='check')+'">Check-in</button></div>'+(tab==='forecast'?forecast()+links:'<p class="compact-title">'+headline+'</p>'+task());
 if(variant==='c')html+=forecast()+'<details id="check-disclosure" open><summary>Record the outcome</summary>'+task()+'</details><details><summary>More about this forecast</summary>'+links+'</details>';
}
if(screen==='evidence'){
 if(variant==='a')html+='<button data-study="Forecast" class="gold">‹ Back to forecast</button><h1>Behind the mist</h1>'+categoryList()+'<details><summary>Which forecast?</summary><p>'+headline+'</p>'+qualification+'</details>';
 if(variant==='b')html+='<h1>Behind the mist</h1><details><summary>View forecast</summary><p>'+headline+'</p>'+qualification+'</details><div class="tabs">'+categories.map((x,i)=>'<button data-category="'+x+'" aria-pressed="'+(i===0)+'">'+x+'</button>').join('')+'</div><section class="reading"><h2>Why this forecast</h2><p>Your recorded context and the scenario’s limits appear here unchanged.</p></section>';
 if(variant==='c')html+='<h1>Behind the mist</h1><nav class="section-nav">'+categories.map((x,i)=>'<a href="#section-'+i+'">'+x+'</a>').join('')+'</nav>'+categories.map((x,i)=>'<section class="section" id="section-'+i+'"><h2>'+x+'</h2><p class="small">'+['The recorded explanation appears here unchanged.','Your original stored answers appear here unchanged.','The recorded scenario conditions appear here unchanged.','Background sources appear here; they do not verify the forecast.'][i]+'</p></section>').join('')+'<button data-study="Forecast" class="quiet">Back to forecast</button>';
}
document.querySelector('#app').innerHTML=html+status;bind();}
function announce(text){document.querySelector('#status').textContent=text+' · layout study only; no forecast or stored data changed.'}
function bind(){const field=document.querySelector('#question');if(field){const resize=()=>{field.style.height='auto';field.style.height=field.scrollHeight+'px'};field.addEventListener('input',resize);document.fonts.ready.then(resize)}document.querySelector('#question')?.addEventListener('input',e=>{if(variant!=='c')draft=e.target.value});document.querySelector('#submit')?.addEventListener('click',()=>announce('Submission preview'));document.querySelector('#edit')?.addEventListener('click',()=>{editing=true;render();document.querySelector('#question').focus()});document.querySelector('#save')?.addEventListener('click',()=>{draft=document.querySelector('#question').value;editing=false;render();document.querySelector('#edit').focus()});document.querySelector('#cancel')?.addEventListener('click',()=>{editing=false;render();document.querySelector('#edit').focus()});document.querySelector('#forecast-tab')?.addEventListener('click',()=>{tab='forecast';render()});document.querySelector('#check-tab')?.addEventListener('click',()=>{tab='check';render()});document.querySelectorAll('.outcome').forEach(b=>b.onclick=()=>{document.querySelectorAll('.outcome').forEach(e=>e.setAttribute('aria-pressed','false'));b.setAttribute('aria-pressed','true');announce('Selected '+b.textContent)});document.querySelectorAll('[data-study]').forEach(b=>b.onclick=()=>announce(b.dataset.study));document.querySelectorAll('[data-category]').forEach(b=>b.onclick=()=>announce(b.dataset.category+' reader'));}
render();document.querySelector('#study').innerHTML='Open mist hierarchy studies. Structural prototypes; no inference or persistence.<br>'+['a','b','c'].map(v=>'<a href="?screen='+screen+'&variant='+v+'&large='+(large?1:0)+'">'+v.toUpperCase()+'</a>').join('')+['compose','forecast','evidence'].map(s=>'<a href="?screen='+s+'&variant='+variant+'&large='+(large?1:0)+'">'+s+'</a>').join('')+'<a href="?screen='+screen+'&variant='+variant+'&large='+(large?0:1)+'">Change text size</a>';if(params.has('capture'))document.querySelector('#study').remove();
