# Public app configuration. Use this task's local Supabase keys only.
# Optional hosted/native override; leave unset for the same-origin web development bridge.
# EXPO_PUBLIC_ENGINE_URL=http://127.0.0.1:8787
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_MODE=mock
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# Server-only; never EXPO_PUBLIC.
OLLAMA_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
MODEL_PROVIDER=ollama
HOSTED_MODEL_URL=
HOSTED_MODEL_NAME=
HOSTED_MODEL_KEY=
# json_object for vendors without strict schema support; semantic validation is always required.
HOSTED_MODEL_FORMAT=json_schema
APP_ORIGIN=http://localhost:8087
# Social moderation service only; never use EXPO_PUBLIC for the service-role key.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=
# Local-only preview entitlement sync. Hosted URLs reject this mode.
SOCIAL_MOCK_ENTITLEMENTS=false
# Enable only after Apple/Supabase linking is configured; preserves anonymous UID.
EXPO_PUBLIC_APPLE_LINK_ENABLED=false
# Before hosted inference: matching provider name in server and app consent UI.
HOSTED_MODEL_DISCLOSURE=
EXPO_PUBLIC_AI_PROVIDER_NAME=
# Local Node testing only: MODEL_PROVIDER=codex uses the existing Codex login.
# Never configure this provider on a deployed server. No API key is needed.
CODEX_MODEL=gpt-6-luna
